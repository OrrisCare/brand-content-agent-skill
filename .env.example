# Scalekit credentials (from Dashboard → Developers → Settings → API Credentials)
SCALEKIT_ENV_URL=https://your-env.scalekit.cloud
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=sks_...

# Connection names — must match Dashboard → AgentKit → Connections exactly
APIFY_CONNECTION_NAME=apifymcp
NOTION_CONNECTION_NAME=notion
GMAIL_CONNECTION_NAME=gmail

# Apify API token (from apify.com → Settings → Integrations)
APIFY_TOKEN=apify_api_...

# User identifier (your internal user ID — any stable string)
USER_IDENTIFIER=user_123

# Notion database IDs (from database page URL)
NOTION_DB_CONTENT_LIBRARY=
NOTION_DB_SCRIPTS=
NOTION_DB_CREATORS=
NOTION_DB_CALENDAR=

# LLM (for agent orchestration)
OPENAI_API_KEY=your_openai_key
# ANTHROPIC_API_KEY=your_anthropic_key

# Suppress noisy gRPC warnings on macOS
GRPC_VERBOSITY=ERROR
